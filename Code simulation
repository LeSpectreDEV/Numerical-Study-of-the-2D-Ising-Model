import numpy as np
import matplotlib.pyplot as plt
from tqdm import tqdm
import time

class Modele_Ising :

    def __init__(self, taille, energie_interaction, champ):
        self.N= taille
        self.model = np.random.choice([-1, 1], size=(self.N,
self.N))
        self.J=energie_interaction
        self.h=champ
        self.m = np.sum(self.model)
        def Energie():
            E_interaction = 0
            E_champ = 0

            for i in range(self.N):
                for j in range(self.N):
                    s = self.model[i, j]
                    # Somme des 4 voisins avec conditions périodiques (modulo N)
                    voisins = (
                        self.model[(i+1)%self.N, j] +
                        self.model[(i-1)%self.N, j] +
                        self.model[i, (j+1)%self.N] +
                        self.model[i, (j-1)%self.N]
                    )
                    E_interaction += -self.J * s * voisins
                    E_champ += -self.h * s

            # On divise l'interaction par 2 (pour ne pas compter les paires en double)
            E = (E_interaction / 2) + E_champ
            return E
        self.E = Energie()

    def Energie(self):
        E_interaction = 0
        E_champ = 0

        for i in range(self.N):
            for j in range(self.N):
                s = self.model[i, j]
                # Somme des 4 voisins avec conditions périodiques (modulo N)
                voisins = (
                    self.model[(i+1)%self.N, j] +
                    self.model[(i-1)%self.N, j] +
                    self.model[i, (j+1)%self.N] +
                    self.model[i, (j-1)%self.N]
                )
                E_interaction += -self.J * s * voisins
                E_champ += -self.h * s

        # On divise l'interaction par 2 (pour ne pas compter les paires en double)
        E = (E_interaction / 2) + E_champ
        return E

    def plot(self):
        plt.imshow(self.model, cmap='coolwarm')
        plt.colorbar()
        plt.show()

    def magnetisation(self):
        return self.m/(self.N**2)

    def Metropolis(self,beta):
        i= np.random.randint(0,self.N)
        j= np.random.randint(0,self.N)

        s= self.model[i][j]
        voisins = (
            self.model[(i+1)%self.N, j] +
            self.model[(i-1)%self.N, j] +
            self.model[i, (j+1)%self.N] +
            self.model[i, (j-1)%self.N]
        )

        diffE= 2 * s * (self.J * voisins + self.h)

# Critère de Metropolis
        if diffE < 0:
            self.m -= 2*self.model[i, j]
            self.E += diffE
            self.model[i, j] *= -1 # On accepte toujours si l'énergie baisse
        else:
            R = np.exp(-beta * diffE)
            p = np.random.uniform(0.0, 1.0)

            # Si p <= R, on accepte le changement
            if p <= R:
                self.m -= 2*self.model[i, j]
                self.E+= diffE
                self.model[i, j] *= -1



## Gemini pour visualiser

def lancer_animation(sim : Modele_Ising, taille=50,
beta=0.5, etapes=100000):

    # 2. Préparation de la figure
    plt.ion() # Active le mode interactif (le code continue après plt.show)
    fig, ax = plt.subplots()

    # On crée l'image une première fois et on garde une référence (img)
    img = ax.imshow(sim.model, cmap='coolwarm', vmin=-1,
vmax=1)
    plt.colorbar(img)
    plt.title(f"Ising 2D - Beta: {beta}")

    # 3. Boucle de simulation
    for k in range(etapes):
        sim.Metropolis(beta)

        # ASTUCE PERFORMANCE :
        # On ne met à jour l'image que tous les N*N étapes (1 pas de Monte Carlo)
        # ou tous les 1000 pas, sinon l'animation sera trop lente.
        if k % 1000 == 0:
            # On met à jour les données de l'image (pas besoin de refaire le plot)
            img.set_data(sim.model)

            # Mise à jour du titre avec l'étape
            ax.set_title(f"Ising 2D - Beta: {beta} - Étape:
{k}")

            # Demande à Matplotlib de redessiner et fait une
micro-pause
            plt.draw()
            plt.pause(0.001)

    plt.ioff() # Désactive le mode interactif à la fin
    plt.show() # Affiche l'état final et bloque pour qu'on
puisse regarder

